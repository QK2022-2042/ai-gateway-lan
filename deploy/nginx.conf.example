# AI Gateway 反向代理示例（可选；网关本身已经可以直接对外提供服务）
#
# 1. 将本文件放到 /etc/nginx/conf.d/ai-gateway.conf
# 2. 准备证书后把证书路径改成自己的
# 3. nginx -t && systemctl reload nginx
# 4. 若通过代理访问，把 /etc/ai-gateway/config.json 的 trust_proxy 改为 true
#    并重启 ai-gateway，这样日志里记录的是客户端真实 IP。
#
# 内网也可以只用 HTTP：删除 listen 443 ssl 两行与证书配置，
# 改成 listen 80; 即可。

upstream ai_gateway_backend {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name gateway.example.lan;
    # 内网无证书时，把下面的 301 也删掉
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name gateway.example.lan;

    ssl_certificate     /etc/nginx/ssl/gateway.crt;
    ssl_certificate_key /etc/nginx/ssl/gateway.key;

    # 请求体可能包含长上下文，适当放大
    client_max_body_size 32m;

    location / {
        proxy_pass http://ai_gateway_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 流式输出（SSE）必须关闭缓冲，并放宽超时
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        add_header X-Accel-Buffering no;
    }
}
